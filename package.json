{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "start": "NODE_ENV=production bun src/index.tsx",
    "build": "bun run build.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test src",
    "check": "bun run typecheck && bun test src && bun run build",
    "check:infra": "cd infra-cdk && npm test -- --runInBand && npm run build",
    "eval:research": "bun evals/research-evals.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@arizeai/openinference-instrumentation-anthropic": "^0.1.11",
    "@aws-sdk/client-dynamodb": "^3.1048.0",
    "@aws-sdk/client-secrets-manager": "^3.1048.0",
    "@aws-sdk/lib-dynamodb": "^3.1048.0",
    "@drawio/mcp": "^1.1.0",
    "@langfuse/otel": "^5.3.0",
    "@langfuse/tracing": "^5.3.0",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/bun": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "@supabase/supabase-js": "^2.95.3",
    "@types/pg": "^8.16.0",
    "better-auth": "^1.4.18",
    "bun-plugin-tailwind": "^0.0.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exa-js": "^2.3.0",
    "lucide-react": "^0.525.0",
    "mapbox-gl": "^3.18.1",
    "pg": "^8.18.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.13.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest"
  }
}
