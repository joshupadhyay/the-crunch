# LLM provider (chatbot)
# openrouter | deepseek | anthropic
LLM_PROVIDER=openrouter
LLM_MODEL=deepseek/deepseek-v4-pro
LLM_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=The Crunch
BROWSER_USE_MODEL=openrouter/deepseek/deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic

# Anthropic fallback
ANTHROPIC_API_KEY=

# Mapbox (map view)
MAPBOX_ACCESS_TOKEN=

# Exa (search tool)
EXA_API_KEY=

# Supabase (database + auth)
DATABASE_URL=
VITE_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
BETTER_AUTH_SECRET=

# Twitter OAuth (BetterAuth social login)
TWITTER_CLIENT=
TWITTER_SECRET=

# Serverless chat storage
# local | supabase | dynamodb
CHAT_STORE=local
CHAT_TABLE_NAME=
MAX_TOOL_ROUNDS=6

# Langfuse observability (server-side only; never expose secret key to React)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Sentry observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# Public browser DSN. This is intentionally separate from server config.
PUBLIC_SENTRY_DSN=
PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
